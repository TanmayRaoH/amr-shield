# ─────────────────────────────────────────────────────────────────────────────
# AMR Shield — frontend environment template
#
# Copy to frontend/.env.local for local overrides. Vite only exposes variables
# prefixed with VITE_ to browser code.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for the API.
#
# Leave unset in development: vite.config.js proxies /api to localhost:5000.
#
# Set this for a production build where the API lives on a different host, e.g.
#   VITE_API_BASE_URL=https://api.example.com/api/v1
# Without it the bundle uses the relative path /api/v1 and therefore requires a
# reverse proxy in front of both the static files and Flask.
# VITE_API_BASE_URL=/api/v1

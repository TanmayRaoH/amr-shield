# ─────────────────────────────────────────────────────────────────────────────
# AMR Shield — backend environment template
#
# Copy to .env and adjust. Every variable has a working default in config.py,
# so the server starts without a .env file at all.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask runtime ────────────────────────────────────────────────────────────

# 'development' enables debug logging and the Flask debugger.
# Use 'production' for anything network-accessible.
FLASK_ENV=development

# Port the Flask dev server binds to. The Vite dev server proxies /api here.
PORT=5000

# Comma-separated list of browser origins allowed to call the API.
# Never set this to '*' — it is deliberately an explicit allow-list.
# Defaults cover Create React App (3000) and Vite (5173) dev servers.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# ── Not yet wired up ─────────────────────────────────────────────────────────
# The variables below are read by config.py but no code uses them yet. They are
# placeholders for planned work — see improvements.md §2.2 and §2.4. Leaving
# them set has no effect on current behaviour.

# MySQL connection — used for prediction history and GLASS response caching.
# Create the database first: run the SQL in README.md under "Database Setup".
DB_HOST=localhost
DB_PORT=3306
DB_NAME=amr_shield
DB_USER=root
DB_PASS=your_mysql_root_password

# WHO GHO OData API base URL — used by GET /api/v1/glass/<country_code>
# This is the publicly queryable backend behind the WHO GLASS dashboard.
# No API key required. Change only if the endpoint moves.
WHO_GLASS_BASE_URL=https://glass.who.int/api

# How long GLASS API responses are cached in MySQL before re-fetching (hours).
CACHE_TTL_HOURS=24
